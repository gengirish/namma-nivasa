# Copy to .env.local — every db:* script reads .env.local, not .env.
# Next.js loads .env.local itself; the Prisma CLI does not, which is why the db:* scripts go
# through scripts/db-env.mjs.
#
# WARNING: `vercel env pull .env.local` OVERWRITES this file with whatever the Vercel project
# holds. Keep local-only values somewhere you can paste back, or add them to the project.

# ── Database (Neon via the Vercel Marketplace) ───────────────────────────────
# `vercel env pull .env.local` writes both of these once the integration is provisioned.
DATABASE_URL=            # pooled connection, used by the app
# DIRECT_URL is OPTIONAL. scripts/db-env.mjs derives it from DATABASE_URL_UNPOOLED /
# POSTGRES_URL_NON_POOLING (what Neon publishes) or falls back to DATABASE_URL. Set it only to
# override that choice — prisma migrate must not run through a pooled connection.
# DIRECT_URL=

# ── Auth (the curation team only; visitors have no accounts) ─────────────────
# Unset is a supported state: middleware degrades to a pass-through, requireRole() refuses
# everything with a 503, and the visitor-facing site is unaffected.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── Rate limiting (falls back to in-memory when unset) ───────────────────────
# The in-memory limiter resets on every cold start and does not coordinate across instances,
# which makes it decorative in production. Set these before launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Outbound ─────────────────────────────────────────────────────────────────
# Where enquiry and owner-submission notifications are addressed.
NIVASA_TEAM_EMAIL=

# ── AgentMail (outbound + inbound email) ────────────────────────────────────
# Unset is a supported state, and it is the pre-provider behaviour exactly: notifications land
# SKIPPED in /dashboard/outbox, and the webhook refuses every request. Nothing else degrades.
#
# Both of the first two are required before anything sends — a key with no inbox cannot pick a
# From address. Create the inbox once with `npx agentmail inboxes create` and paste the id
# (it looks like an address: hello@yourname.agentmail.to).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# The Svix signing secret for the webhook endpoint, from the AgentMail console when you point
# it at https://<your-domain>/api/webhooks/agentmail. Starts `whsec_`. Unset means the route
# rejects everything with a 503 — it never falls through to trusting an unverified body.
AGENTMAIL_WEBHOOK_SECRET=

# ── Reply agent ──────────────────────────────────────────────────────────────
# Drafts replies to inbound mail. Unset means inbound messages are still recorded and still
# appear in /dashboard/inbox — they just arrive without a suggested reply.
ANTHROPIC_API_KEY=

# Autonomous sending. Unset or anything other than `1` means EVERY drafted reply waits for a
# curator, which is the intended posture until the drafts have been read for a while. Set to 1
# and the narrow intent whitelist in lib/reply-agent.ts sends without a human; everything
# outside it still waits.
NIVASA_AGENT_AUTOSEND=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <secret>` to /api/cron/*. Unset means those
# routes answer 503 rather than running for an anonymous caller — the same posture the AgentMail
# webhook takes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# The public origin. Links composed for outbound messages are built from this, and delivery
# refuses to send when it resolves to localhost — a dead link is indistinguishable from a live
# one until the recipient taps it. In production this must be the real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
