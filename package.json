{
  "name": "namma-nivasa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "node scripts/run-with-env.mjs PW_PROD=1 -- playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:deployed": "playwright test --config playwright.deployed.config.ts",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/db-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/db-env.mjs prisma migrate deploy",
    "db:studio": "node scripts/db-env.mjs prisma studio",
    "db:seed": "node scripts/db-env.mjs tsx prisma/seed.ts",
    "env:pull": "node scripts/pull-env.mjs",
    "db:setup": "node scripts/pull-env.mjs && node scripts/db-env.mjs prisma migrate deploy && node scripts/db-env.mjs tsx prisma/seed.ts",
    "listing:create": "node scripts/db-env.mjs tsx scripts/create-listing.ts",
    "listing:update": "node scripts/db-env.mjs tsx scripts/update-listing.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@clerk/nextjs": "^7.7.1",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "agentmail": "^0.5.19",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^1.99.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node scripts/db-env.mjs tsx prisma/seed.ts"
  }
}
